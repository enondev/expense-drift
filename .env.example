# Cloudflare D1 & KV (required for collector)
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_D1_DATABASE_ID=""
CF_KV_NAMESPACE_ID=""

# LLM Extraction ("local" | "byok" | "off")
LLM_PROVIDER="local"
LLM_BASE_URL="http://127.0.0.1"
LLM_MODEL="gpt-oss-20b"
# LLM_API_KEY="" # Required only when LLM_PROVIDER="byok"

# Cold Storage (Backblaze B2 or Tigris S3-compatible)
S3_ENDPOINT="https://backblazeb2.com"
S3_BUCKET="expensedrift-archive"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Control Plane Security (cmd/server)
PORT="8080"
ADMIN_USER="admin"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
TRIGGER_SECRET="CHANGE_ME_RANDOM_BEARER_TOKEN"
